# Production URL used for canonical URLs, Open Graph and sitemap.
# Default during development is window.location.origin.
VITE_SITE_URL=https://angelora-two.vercel.app

# Advertising: enabled once an AdSense publisher is set up (client id is in
# src/config.ts). Ad units show only after consent + a real slot ID is set.
VITE_ADS_ENABLED=true